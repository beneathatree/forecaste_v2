# Anthropic API key (Claude Code in Docker)
ANTHROPIC_API_KEY=

# GitHub CLI token — same as GITHUB_TOKEN; `gh` reads GH_TOKEN
GH_TOKEN=

# In the GitHub repo, create label `s-castle` for issues Sand Castle should pick up
# (GitHub → Labels, or after `gh auth login`: gh label create "s-castle" --color "5319E7")
#
# Setup + credentials: docs/sandcastle/TOKENS-AND-WIRING-GUIDE.md and docs/sandcastle/README.md
